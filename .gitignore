# Byte-compiled
__pycache__/
*.pyc
# Dump/output artifacts
*.bin
*.hex
*.dump
*.npz
# venv (lives separately at ~/.cwvenv)
.venv/
# Build artifacts
*.o
*.elf
scripts/usb_reset
# Local test fixture: seed + PIN for the planted rehearsal storage.
# Regenerate locally with storage-sim/make_storage.py — never commit.
storage-sim/known-answer.json

# Campaign shot logs & run dumps (timestamped, generated fresh every run)
storage-sim/campaigns/
storage-sim/dumps/
*.log

# Scope screenshots (timestamped BMP/PNG land in scope/)
scope/*.bmp
scope/*.png

# LA captures (.sr = big timestamped binary session artifacts)
*.sr

# Vendored firmware source tree: public, pinned at tag legacy/v1.13.1,
# re-downloadable from trezor upstream. 67 MB / 4k files - never commit.
trezor-firmware-legacy-v1.13.1/

# Per-chip workspaces (chip-a/chip-c): practice fixtures + generated artifacts.
# Seeds/PINs live ONLY in the gitignored known-answer.json; keep README/notes.
storage-sim/chips/*/known-answer.json
storage-sim/chips/*/archive/
storage-sim/chips/*/campaigns/
storage-sim/chips/*/dumps/
storage-sim/chips/*/opencode_logs/
storage-sim/chips/*/scope_captures/
storage-sim/chips/*/SRAM_*/
storage-sim/chips/*/la_captures/

# Jerin-Sunny LA frame archive: 267 MB raw - keep contact sheet + webm only
docs/archive/jerinsunny_memory_read_frames/frames_all/
docs/archive/jerinsunny_memory_read_frames/frames_unique/
